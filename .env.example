# Copy this file to ".env" and fill in real values.
# .env is git-ignored; .env.example is committed as a template.

# --- Core Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Leave empty to use local SQLite (db.sqlite3).
# For production: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=

# --- Redis (for Django Channels in production) ---
# Leave empty for local dev (uses InMemoryChannelLayer, single-process only).
# Upstash format: rediss://default:PASSWORD@host:port
REDIS_URL=

# --- CORS ---
# Comma-separated. Use * for dev only.
CORS_ALLOWED_ORIGINS=*
